diff --git a/src/core/publicFields.ts b/src/core/publicFields.ts
new file mode 100644
index 0000000..2f21773
--- /dev/null
+++ b/src/core/publicFields.ts
@@ -0,0 +1,16 @@
+/** 只使用平台公开的真实标识；缺失时保持匿名，不从昵称生成身份。 */
+export function publicUserId(user: { secUid?: string; id?: string; idStr?: string }): string | undefined {
+  const secUid = user.secUid?.trim();
+  if (secUid && !/^0+$/.test(secUid)) return secUid;
+  // 当前 1.4.1 User 解码器只有 id；idStr 仅兼容未来解码器。
+  for (const value of [user.idStr, user.id]) {
+    const id = value?.trim();
+    if (id && /^[0-9]+$/.test(id) && !/^0+$/.test(id)) return id;
+  }
+  return undefined;
+}
+
+/** SocialMessage.action 是 int64 字符串；其他值原样保留为未知。 */
+export function socialAction(action?: string): 'follow' | 'share' | 'unknown' {
+  return action === '1' ? 'follow' : action === '2' ? 'share' : 'unknown';
+}
