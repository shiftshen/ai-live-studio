{
  "name": "ai-live-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "check": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "doctor": "tsx scripts/doctor.ts",
    "up": "node scripts/service.mjs start",
    "down": "node scripts/service.mjs stop"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.0",
    "lucide-vue-next": "^0.468.0",
    "sharp": "^0.34.0",
    "tiktok-live-connector": "^2.1.0",
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
